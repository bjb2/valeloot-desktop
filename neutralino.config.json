{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "dev.spiritvale.valeloot",
  "version": "0.1.1",
  "applicationName": "ValeLoot Desktop",
  "author": "ValeLoot",
  "description": "Standalone passive Spirit Vale loot alerts for Windows",
  "defaultMode": "window",
  "port": 0,
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "url": "/views/main/index.html",
  "documentRoot": "/resources/",
  "nativeAllowList": ["app.broadcast"],
  "extensions": [
    {
      "id": "dev.spiritvale.valeloot.backend",
      "commandWindows": "\"${NL_PATH}/extensions/bin/bun.exe\" --no-orphans \"${NL_PATH}/extensions/backend/index.js\""
    }
  ],
  "modes": {
    "window": {
      "title": "ValeLoot Desktop",
      "width": 1280,
      "height": 760,
      "minWidth": 980,
      "minHeight": 620,
      "borderless": false,
      "resizable": true,
      "exitProcessOnClose": true,
      "injectGlobals": true,
      "injectClientLibrary": false,
      "useLogicalPixels": true
    }
  },
  "cli": {
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0",
    "resourcesPath": "resources",
    "extensionsPath": "extensions",
    "binaryName": "valeloot-desktop",
    "distributionPath": "dist",
    "copyItems": [".valeloot-portable", "neutralino.config.json"]
  }
}
